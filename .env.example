# Database (SQLite is enough for the hackathon MVP)
DATABASE_URL="file:./dev.db"

# --- Login pemilik (lihat /owner-login dan src/middleware.ts) ---
# Satu PIN untuk semua pemilik. WAJIB diisi di production (Vercel env vars),
# kalau kosong /dashboard tidak bisa diakses siapa pun.
OWNER_PIN="123456"

# --- Filled in once the Langflow pipelines are deployed (see BOB_BRIEF.md) ---
LANGFLOW_BASE_URL=""
LANGFLOW_VOICE_TO_TRANSACTION_FLOW_ID=""
LANGFLOW_RADAR_TETANGGA_FLOW_ID=""
LANGFLOW_PROMO_FLOW_ID=""
LANGFLOW_API_KEY=""

# Node id of the "Prompt Template" component inside the Generative Promo flow.
# See src/app/api/promo/generate/route.ts — this is the tweaks target used to
# inject merchant_name and recent_items_text into the prompt at run time.
# Find it via GET {LANGFLOW_BASE_URL}/api/v1/flows/{LANGFLOW_PROMO_FLOW_ID}
# (flow.data.nodes[].id where data.type == "Prompt Template").
LANGFLOW_PROMO_PROMPT_TEMPLATE_COMPONENT_ID=""

# Node id of the "Speech-to-Text (Gemini)" custom component inside the
# Voice-to-Transaction flow. See src/app/api/voice/extract/route.ts — this is
# the tweaks target used to point the FileInput at the uploaded audio file.
# Find it via GET {LANGFLOW_BASE_URL}/api/v1/flows/{flow_id} (flow.data.nodes[].id).
LANGFLOW_VOICE_STT_COMPONENT_ID=""

# Node id of the "Radar Tetangga Aggregator" custom component inside the
# Radar Tetangga flow. See src/app/api/radar/route.ts — tweaks target used to
# pass item_label into the deterministic aggregation component.
LANGFLOW_RADAR_AGGREGATOR_COMPONENT_ID=""

# --- Radar Tetangga internal aggregation endpoint ---
# See src/app/api/internal/item-prices/route.ts. Shared secret checked
# against the x-radar-internal-secret header. Called ONLY by the Langflow
# "Radar Tetangga Aggregator" component (server-to-server), never the
# browser. Must also be set as a Langflow Global Variable of the same name
# (Settings -> Global Variables) so the component can load it.
RADAR_INTERNAL_SECRET=""

# --- watsonx Orchestrate integration ---
# WATSONX_ORCHESTRATE_BASE_URL and WATSONX_ORCHESTRATE_API_KEY are used from
# the Orchestrate console side (when registering OpenAPI tools) — Next.js does
# NOT call Orchestrate; Orchestrate calls Next.js.
WATSONX_ORCHESTRATE_BASE_URL=""
WATSONX_ORCHESTRATE_API_KEY=""

# Shared secret for POST /api/internal/audit-log and GET /api/internal/audit-log.
# Checked against the `x-orchestrate-internal-secret` request header.
# Same pattern as RADAR_INTERNAL_SECRET — never commit the real value.
# Also set this as a credential in the watsonx Orchestrate credential vault
# so the Payment-Event agent can call /api/internal/audit-log directly.
ORCHESTRATE_INTERNAL_SECRET=""

# --- QRIS aggregator webhook (see src/app/api/webhook/qris/route.ts) ---
# Current mode: shared-secret header check (demo-safe).
# QRIS_WEBHOOK_SECRET is matched against the x-qris-webhook-secret header.
QRIS_WEBHOOK_SECRET="demo-secret-change-me"

# TODO: once a real aggregator (Midtrans / Xendit / Duitku) is onboarded,
# replace the shared-secret check with HMAC-SHA256 verification and fill in:
# QRIS_WEBHOOK_HMAC_SECRET=""      # the signing secret from your aggregator dashboard
# QRIS_AGGREGATOR_BASE_URL=""      # aggregator API base URL (for status callbacks, if needed)
